      "title": "Bootstrap context",
      "kind": "stage",
      "status": "done",
      "instructions": "instructions/bootstrap-context.md",
      "agent": {
        "model": "haiku",
        "effort": "low"
      },
      "produces": [
        "workflow.json"
      ],
      "acceptance": [
        "project.name, type, stack and language are filled in workflow.json",
        "harness.enabled decided (true/false) and profile pointed at the right file"
      ],
      "started_at": "2026-07-22T13:16:42Z",
      "completed_at": "2026-07-22T13:16:42Z"
    },
    {
