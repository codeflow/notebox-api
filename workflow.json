{
  "$schema": "./workflow.schema.json",
  "version": "1.0.0",
  "project": {
    "name": "notebox-api",
    "type": "api",
    "stack": [
      "java",
      "jakarta",
      "jpa",
      "cdi",
      "mysql"
    ],
    "language": "en",
    "code_naming": "english",
    "comments": {
      "scope": "minimal",
      "reference_docs": "javadoc",
      "api_docs": "openapi"
    }
  },
  "engine": {
    "name": "default"
  },
  "harness": {
    "enabled": true,
    "profile": "harness/profiles/api.md",
    "verify": "mvn -B verify",
    "ci": ".github/workflows/ci.yml",
    "signals": [
      "lint",
      "typecheck",
      "test",
      "build"
    ],
    "commands": {
      "test": "mvn -B test",
      "build": "mvn -B package",
      "typecheck": "mvn -B compile",
      "lint": "echo 'lint: Checkstyle/Spotless not yet wired (tracked as F3); placeholder passes'"
    }
  },
  "github": {
    "enabled": true,
    "repo": "codeflow/notebox-api",
    "default_branch": "main",
    "assignee": "rafaelsantos",
    "reviewers": [],
    "commit_convention": "conventional",
    "artifacts": {
      "readme": "README.md",
      "changelog": "CHANGELOG.md"
    },
    "project": {
      "enabled": false,
      "owner": ""
    },
    "sync": {
      "issue_per": "feature",
      "pr_per": "feature",
      "comment_on_gate": true,
      "changelog_on": "audit_pass"
    },
    "integration_branch": "develop"
  },
  "defaults": {
    "agent": {
      "model": "sonnet",
      "effort": "medium"
    },
    "background": false,
    "gate": "none"
  },
  "policy": {
    "render_pipeline_before_response": true,
    "strict_gates": true,
    "single_in_progress": true,
    "escalate_on_constitution_violation": true,
    "auto_append_features": true,
    "ask_agent_review": true
  },
  "steps": [
