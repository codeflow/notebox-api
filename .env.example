# Notebox API — environment configuration (C-05)
# Copy to .env for local overrides; in real environments these come from a secret manager.
# NEVER commit real secrets. The committed publicKey.pem/privateKey.pem are DEV/TEST ONLY.

# --- Database (prod) ---
QUARKUS_DATASOURCE_JDBC_URL=jdbc:mysql://db-host:3306/notebox
QUARKUS_DATASOURCE_USERNAME=notebox
QUARKUS_DATASOURCE_PASSWORD=change-me

# --- JWT keys (prod) — required; must point to secret-mounted key files, not the committed dev keys ---
MP_JWT_VERIFY_PUBLICKEY_LOCATION=/etc/notebox/keys/publicKey.pem
SMALLRYE_JWT_SIGN_KEY_LOCATION=/etc/notebox/keys/privateKey.pem

# --- JWT tuning (optional) ---
NOTEBOX_JWT_TTL_SECONDS=3600
